# OpenFOAM run outputs (regenerated) — keep only tracked source (0.orig, system, constant/*, scripts)
cases/**/[0-9]*/
cases/**/processor*/
cases/**/*.foam
cases/**/log.*
cases/**/postProcessing/
cases/**/runs/**/fields/
case_template/[0-9]*/
case_template/processor*/

# meshes are regenerated from geometry/*.py
*.msh
**/polyMesh/
**/constant/*/polyMesh/
constant/cellToRegion*

# OpenFOAM solver build artifacts (rebuilt by Allwmake)
**/linux64*/
**/lnInclude/
*.o
*.so
*.dep

# python
__pycache__/
*.pyc
.venv/

# generated mesh metadata (written by make_full_block.py)
geometry/fuel_zones.json

# benchmark source documents (large external PDFs + their .txt extractions);
# the distilled data used by the report is kept in benchmark/README.md
benchmark/spec/
benchmark/refs/

# scratch / archived scripts, not part of the deliverable
archive/

# LaTeX build artifacts (keep only .tex source and compiled .pdf)
*.aux
*.log
*.nav
*.out
*.snm
*.toc
*.vrb
*.fls
*.fdb_latexmk
*.synctex.gz
presentation/pass.log
