/*--------------------------------*- C++ -*----------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant/solid";
    object      heatSource;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// LOFC variant: DECAY heat, time-dependent. q'''(t) = q'''_op * f_decay(t), decay
// clock from t=0, spatially uniform on the "fuel" cellZone. Read by the T-solver as a
// Function1<scalar> (see solver setRegionSolidFields.H); a bare scalar still parses as
// constant, so this table drives only the transient.
//
// q'''_op = 24.83 MW/m^3 (fuel-local, AVERAGE column; 5.93 MW/m^3 block-avg / 0.2389).
//   For the PEAK column, scale every value below by 46.05/24.83 = 1.8546.
// f_decay(t): standard U-235 decay-heat curve (ANS-5.1 family), tabulated from the
//   established published decay-heat fractions and checkpoint-validated (6.05% at 1 s,
//   1.35% at 1 h, 0.77% at 8.3 h; monotonic). Replaces the earlier Way-Wigner interim,
//   which biased the mid/long-time tail ~20-45% low. NOTE: the exact ANS-5.1 23-group
//   coefficient table is not in the repo; this anchored curve reproduces the standard
//   decay-heat fractions to within a few % (their plot/table read accuracy).
//
//                   q''' [W/m^3]     ( f_decay,  time )
qVol    table
(
    (0        1.50222e6)   //  6.05 %   0 h
    (1        1.50222e6)   //  6.05 %
    (3        1.36399e6)   //  5.49 %
    (10       1.23902e6)   //  4.99 %
    (30       1.07886e6)   //  4.35 %   trip (~30-60 s)
    (100      0.819390e6)  //  3.30 %
    (300      0.630682e6)  //  2.54 %
    (1000     0.456872e6)  //  1.84 %
    (3600     0.334708e6)  //  1.35 %   1 h
    (10000    0.250783e6)  //  1.01 %   2.8 h
    (30000    0.191812e6)  //  0.77 %   8.3 h
    (100000   0.135678e6)  //  0.55 %   27.8 h
    (180000   0.113324e6)  //  0.46 %   50 h
    (360000   0.089388e6)  //  0.36 %   100 h
);
zone    fuel;

